{
  "name": "@sa-library/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx test/run.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:e2e": "tsx test/run.ts --browser"
  },
  "dependencies": {
    "@sa-library/shared": "workspace:*",
    "express": "^5.2.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "dotenv": "^17.2.0",
    "zod": "^4.3.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "vitest": "^4.0.0",
    "supertest": "^7.2.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3"
  }
}
